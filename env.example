# Telegram BotFather token — वास्तविक token यहाँ भरें
BOT_TOKEN=replace_with_botfather_token

# Telegram Bot API getFile limit सामान्यतः 20 MB है
MAX_INPUT_MB=20
# Telegram upload के सुरक्षित सीमा के नीचे रखें
MAX_OUTPUT_MB=49

# एक user को इस window में कितनी files process करने दें
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX=5

# Memory बचाने के लिए single worker queue
MAX_QUEUE_SIZE=20
TEMP_DIR=/app/tmp

# Video browser processing timeout: inactivity timeout in milliseconds
VIDEO_TIMEOUT_MS=600000
# 12 Mbps default quality profile
VIDEO_BITRATE=12000000

# error, warn, info, debug, silent
LOG_LEVEL=info
